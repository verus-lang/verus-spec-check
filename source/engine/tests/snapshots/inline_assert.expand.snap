::vstd::prelude::verus!{
    #[allow(unused_imports)]
    use::verus_spec_check_vstd_ext::*;
}
::vstd::prelude::verus!{
    #[doc = "verus_spec_check::skip_regular_harness"]
    fn checked_add(a : u16, b : u16) -> (r : u32) ensures r == a as u32 + b as u32,
    {
        let r = a as u32 + b as u32;
        assert(r >= a as u32);
        r
    }
}
