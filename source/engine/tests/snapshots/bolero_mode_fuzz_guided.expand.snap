                if!((!(a >= b) || (::verus_spec_check::__vcheck_int::eq(r,::verus_spec_check::__vcheck_int::sub(a, b))))) {
                    return::verus_spec_check::cov_fuzz::ContractExec::Failed("ensures clause failed: `a >= b ==> r == a - b`");
                }
                if!((!(a < b) || (::verus_spec_check::__vcheck_int::eq(r,::verus_spec_check::__vcheck_int::sub(b, a))))) {
                    return::verus_spec_check::cov_fuzz::ContractExec::Failed("ensures clause failed: `a < b ==> r == b - a`");
                }
                ::verus_spec_check::cov_fuzz::ContractExec::Tested
