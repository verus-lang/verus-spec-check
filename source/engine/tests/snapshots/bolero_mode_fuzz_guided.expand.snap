::vstd::prelude::verus!{
    #[allow(unused_imports)]
    use::verus_spec_check_vstd_ext::*;
}
::vstd::prelude::verus!{
    #[doc = "verus_spec_check::backend = bolero"]
    #[doc = "verus_spec_check::bolero::mode = fuzz"]
    #[doc = "__verus_spec_check_harness_marker__"]
    fn bounded_abs_diff(a : u8, b : u8) -> (r : u8) requires a <= 200,
    ensures a >= b ==> r == a - b,
    a < b ==> r == b - a,
    {
        if a >= b {
            a - b
        } else {
            b - a
        }
    }
}
#[cfg(test)]
#[allow(non_snake_case)]
#[allow(unused_imports)]
#[allow(dead_code)]
mod __verus_spec_check_ID {
    use super::*;
    use::verus_spec_check::proptest::prelude::*;
    use::verus_spec_check_vstd_ext::*;
    use::verus_spec_check::{
        VcheckBTreeMapExec,
        VcheckBTreeSetExec
    };
    #[allow(clippy::declare_interior_mutable_const)]
    const __VCHECK_FUZZ_FALSE_bounded_abs_diff :::core::sync::atomic::AtomicBool =::core::sync::atomic::AtomicBool::new(false);
    static __VCHECK_FUZZ_HITS_bounded_abs_diff : [::core::sync::atomic::AtomicBool; 2usize] = [__VCHECK_FUZZ_FALSE_bounded_abs_diff; 2usize];
    #[allow(non_snake_case, dead_code)]
    pub(super) fn __vcheck_fuzzmark_bounded_abs_diff(__vcheck_i : usize) {
        if let::core::option::Option::Some(__vcheck_b) = __VCHECK_FUZZ_HITS_bounded_abs_diff.get(__vcheck_i) {
            __vcheck_b.store(true,::core::sync::atomic::Ordering::Relaxed);
        }
    }
    #[doc = "verus_spec_check::backend = bolero"]
    #[doc = "verus_spec_check::bolero::mode = fuzz"]
    #[doc = "__verus_spec_check_harness_marker__"]
    #[allow(unused_variables, unused_mut, dead_code, non_snake_case)]
    pub(super) fn __vcheck_fuzz_fn_bounded_abs_diff(a : u8, b : u8) -> u8 {
        if a >= b {
            __vcheck_fuzzmark_bounded_abs_diff(0usize);
            a - b
        } else {
            __vcheck_fuzzmark_bounded_abs_diff(1usize);
            b - a
        }
    }
    #[test]
    #[allow(unexpected_cfgs)]
    fn vcheck_bounded_abs_diff() {
        #[cfg(any(fuzzing_libfuzzer, fuzzing_afl, fuzzing_honggfuzz, fuzzing_random, kani))]
