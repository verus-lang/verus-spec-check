::verus_spec_check::verus_spec_check_unverified!{
    #[doc = "verus_spec_check::backend = bolero"]
    #[doc = "verus_spec_check::bolero::mode = kani"]
    #[doc = "__verus_spec_check_harness_marker__"]
    fn safe_add(a : u16, b : u16) -> (r : u32) requires a <= 1000,
    ensures r == a as u32 + b as u32,
    {
        a as u32 + b as u32
    }
}
