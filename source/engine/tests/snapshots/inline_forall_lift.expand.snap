#[allow(unused_imports)]
use::vstd::contrib::exec_spec::*;
::vstd::contrib::exec_spec::exec_spec_unverified!{
    spec fn __vcheck_clause_make_zeros_0(__vcheck_ret_val : Seq<i64>) -> bool {
        forall | i : usize | 0 <= i < __vcheck_ret_val.len() ==> __vcheck_ret_val[i as int] == 0
    }
}
::vstd::prelude::verus!{
    #[doc = "__verus_spec_check_harness_marker__"]
    fn make_zeros(n : u8) -> (r : Vec<i64>) ensures r.len() == n as usize,
    forall | i : usize | 0 <= i < r.len() ==> r[i as int] == 0,
    {
        Vec::new()
    }
}
#[cfg(test)]
#[allow(non_snake_case)]
#[allow(unused_imports)]
#[allow(dead_code)]
mod __verus_spec_check_ID {
    use super::*;
    use::verus_spec_check::proptest::prelude::*;
    use::verus_spec_check_vstd_ext::*;
    use::verus_spec_check::{
        VcheckBTreeMapExec,
        VcheckBTreeSetExec
    };
    proptest!{
        #![proptest_config(::verus_spec_check::proptest::test_runner::Config {
            max_global_rejects : 1_000_000,
            ..::verus_spec_check::proptest::test_runner::Config::default()
        })] #[test]
        fn vcheck_make_zeros(n in::verus_spec_check::vcheck_strategy::<u8>()) {
            let r = super::make_zeros(n);
            ::verus_spec_check::proptest::prop_assert!(r.len() == n as usize, "ensures clause failed");
            ::verus_spec_check::proptest::prop_assert!(exec___vcheck_clause_make_zeros_0(r.as_slice()), "ensures clause failed");
        }
    }
}
